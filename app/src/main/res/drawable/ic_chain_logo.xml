<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="120dp"
    android:height="120dp"
    android:viewportWidth="120"
    android:viewportHeight="120">

    <!-- Simple chain link design -->
    <!-- Left link -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#00C781"
        android:strokeWidth="8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M 30,45
                         C 30,35 35,30 45,30
                         L 55,30
                         C 65,30 70,35 70,45
                         L 70,55
                         C 70,65 65,70 55,70
                         L 45,70
                         C 35,70 30,65 30,55
                         Z"/>

    <!-- Right link (overlapping) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#00C781"
        android:strokeWidth="8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M 50,55
                         C 50,45 55,40 65,40
                         L 75,40
                         C 85,40 90,45 90,55
                         L 90,65
                         C 90,75 85,80 75,80
                         L 65,80
                         C 55,80 50,75 50,65
                         Z"/>
</vector>

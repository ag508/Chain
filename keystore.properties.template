# Android Keystore Configuration Template
# Copy this file to 'keystore.properties' and fill in your keystore details
# IMPORTANT: Never commit keystore.properties to version control!

# Path to your keystore file (relative to project root)
storeFile=chain-release-key.keystore

# Password for the keystore
storePassword=YOUR_KEYSTORE_PASSWORD_HERE

# Alias name for the signing key
keyAlias=chain-release-key

# Password for the signing key
keyPassword=YOUR_KEY_PASSWORD_HERE

# ============================================================
# HOW TO GENERATE A RELEASE KEYSTORE:
# ============================================================
#
# Run this command in your terminal (from project root):
#
# keytool -genkey -v -keystore chain-release-key.keystore -alias chain-release-key -keyalg RSA -keysize 2048 -validity 10000
#
# You will be prompted to enter:
# - Keystore password (remember this!)
# - Key password (can be same as keystore password)
# - Your name and organization details
#
# This will create 'chain-release-key.keystore' file in your project root.
#
# IMPORTANT NOTES:
# ================
# 1. KEEP YOUR KEYSTORE SAFE - You cannot update your app without it!
# 2. BACKUP your keystore file to a secure location
# 3. NEVER commit keystore.properties or .keystore files to Git
# 4. For production apps, consider using Google Play App Signing
# 5. The keystore password and file must be kept secret
#
# After creating the keystore:
# 1. Copy this file to 'keystore.properties'
# 2. Update the passwords in keystore.properties
# 3. Build with: ./gradlew assembleRelease
#
